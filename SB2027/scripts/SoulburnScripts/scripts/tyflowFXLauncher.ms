-------------------------------------------------------------------------------
-- tyflowFXLauncher.ms
-- By SoulBurn 2027 Update
-- v 2.00
-- Created On: 05/01/25
-- Modified On: 05/01/25
-- tested using Max 2027 + tyFlow
-------------------------------------------------------------------------------

-------------------------------------------------------------------------------
-- Required Files:
-- sLib.ms
-- scripts/SoulburnScripts/lib/tyfx.py
-- scripts/SoulburnScripts/lib/raceanim.py
-------------------------------------------------------------------------------

-------------------------------------------------------------------------------
-- Description:
-- Three-tab launcher for tyFlow FX scripts generated by tyfx.py.
-- Tabs: Tyre Smoke, Crash Debris, Crash Sparks.
-- Each tab: set parameters, Generate (writes .ms), Open (review in the
-- MaxScript editor), Run (executes the .ms inside an undo block).
-- WARNING: Review generated scripts before running - they execute in Max.
-------------------------------------------------------------------------------

-------------------------------------------------------------------------------
-- v2.00 notes:
--
-- All three tyfx.py entry points require a CIRCUIT SPLINE ("spine"): the list
-- of (x,y) vertices used to build the speed profile that gates the effect. The
-- v1.00 UI never supplied it, and called write_smoke_script with keyword names
-- that do not exist (emitter_names=, wind_speed=), so smoke generation always
-- raised a TypeError and debris/sparks were never implemented at all.
--
-- v2.00 adds a spline picker, passes the real signature
--   write_smoke_script(path, emitter_nodes, spine, *, wind_bearing_deg, ...)
-- and implements debris and sparks via raceanim.CrashSpec.
--
-- Parameters exposed here are exactly those tyfx.py accepts. Per-wheel toggles,
-- smoke colour gradients, debris size/friction and spark gradients are NOT
-- exposed because the backend has no arguments for them - adding dead controls
-- would be worse than leaving them out.
--
-- tyfx.py also provides spine-free rain, dust and fire effects
-- (write_rain_script / write_dust_script / write_fire_script) which are not
-- surfaced here yet.
-------------------------------------------------------------------------------

-------------------------------------------------------------------------------
(
-- Globals
global tyflowFXLauncherDefaults
global tyflowFXLauncherUI

global tFXCloseOpenUI
global tFXHelp
global tFXLoadDef
global tFXSaveDef
global tFXDefineUI
global tFXRollout
global tFXFloater
global tFXGetPyLibPath
global tFXCheckTyFlow
global tFXSpineLiteral
global tFXNodeListLiteral
global tFXGenerate
global tFXRunGenerated

-- Includes
include "$userScripts\SoulburnScripts\lib\sLib.ms"

-- Variables
-- Shared
tFXSpineName = ""
tFXDryRunValue = false
-- Smoke
tFXSmokeEndFrameValue = 100
tFXSmokeWindBearingValue = 270.0
tFXSmokeWindSpeedValue = 5.0
tFXSmokeSpeedThresholdValue = 30.0
tFXSmokeSiteZValue = 0.0
tFXSmokeEmitterNames = ""
-- Debris
tFXDebrisEndFrameValue = 100
tFXDebrisSiteZValue = 0.0
tFXDebrisFPSValue = 24
tFXDebrisWingNames = ""
tFXDebrisDistanceValue = 3650.0
-- Sparks
tFXSparksEndFrameValue = 100
tFXSparksSiteZValue = 0.0
tFXSparksFPSValue = 24
tFXSparksFloorNames = ""
tFXSparksDistanceValue = 3650.0

tFXPosValue = sLibGetSafeUIPos 380 470

global tFXSmokeGeneratedPath = undefined
global tFXDebrisGeneratedPath = undefined
global tFXSparksGeneratedPath = undefined
global tFXResultPath = ""
global tFXResultSummary = ""
global tFXStatus = "Ready."

-- Functions

fn tFXGetPyLibPath =
	(
	return ((getdir #userScripts) + "\\SoulburnScripts\\lib\\tyfx.py")
	)

fn tFXCheckTyFlow = ( try ((classOf tyFlow) != UndefinedClass) catch false )

fn tFXNodeListLiteral namesStr =
	(
	-- "a, b ,c" -> "['a','b','c']"  (empty -> "[]")
	local parts = filterString namesStr ","
	local out = "["
	local first = true
	for p in parts do
		(
		local t = trimLeft (trimRight p)
		if t.count == 0 then continue
		if not first then out += ","
		out += ("'" + t + "'")
		first = false
		)
	return (out + "]")
	)

fn tFXSpineLiteral splineName =
	(
	-- Builds the Python "[(x,y),...]" vertex list from a scene spline.
	-- tyfx.py needs this to compute the speed profile that gates every effect.
	if splineName.count == 0 then return ""
	local node = getNodeByName splineName
	if node == undefined then return ""
	if (superClassOf node != shape) then return ""
	local out = "["
	local total = 0
	try
		(
		for s = 1 to (numSplines node) do
			(
			for k = 1 to (numKnots node s) do
				(
				local p = getKnotPoint node s k
				if total > 0 then out += ","
				out += ("(" + (p.x as string) + "," + (p.y as string) + ")")
				total += 1
				)
			)
		)
	catch (return "")
	if total < 3 then return ""
	return (out + "]")
	)

fn tFXGenerate effect =
	(
	-- Writes a temp .py that calls the real tyfx.py signature and hands the
	-- result back through MaxScript globals (no JSON round-trip to parse).
	local pyPath = tFXGetPyLibPath()
	if not (doesFileExist pyPath) then
		(
		MessageBox ("tyfx.py not found at:\n" + pyPath) title:"tyflowFXLauncher"
		return undefined
		)

	local spine = tFXSpineLiteral tFXSpineName
	if spine == "" then
		(
		MessageBox "Pick a circuit spline with at least 3 knots first.\n\ntyfx.py builds its speed profile from the spline vertices - every effect is gated on it." title:"tyflowFXLauncher"
		return undefined
		)

	local libDir = getFilenamePath pyPath
	local outDir = (getdir #temp)
	local outPath = ""
	local call = ""

	case effect of
		(
		#smoke:
			(
			outPath = outDir + "\\sb_tyfx_smoke.ms"
			call = "tyfx.write_smoke_script(r'" + outPath + "', " + (tFXNodeListLiteral tFXSmokeEmitterNames) + ", spine" + \
				", wind_bearing_deg=" + (tFXSmokeWindBearingValue as string) + \
				", wind_speed_ms=" + (tFXSmokeWindSpeedValue as string) + \
				", speed_threshold_ms=" + (tFXSmokeSpeedThresholdValue as string) + \
				", site_z=" + (tFXSmokeSiteZValue as string) + \
				", end_frame=" + (tFXSmokeEndFrameValue as string) + ")"
			)
		#debris:
			(
			outPath = outDir + "\\sb_tyfx_debris.ms"
			call = "tyfx.write_debris_script(r'" + outPath + "', " + (tFXNodeListLiteral tFXDebrisWingNames) + ", spine, spec" + \
				", site_z=" + (tFXDebrisSiteZValue as string) + \
				", end_frame=" + (tFXDebrisEndFrameValue as string) + \
				", fps=" + (tFXDebrisFPSValue as string) + ")"
			)
		#sparks:
			(
			outPath = outDir + "\\sb_tyfx_sparks.ms"
			call = "tyfx.write_sparks_script(r'" + outPath + "', " + (tFXNodeListLiteral tFXSparksFloorNames) + ", spine, spec" + \
				", site_z=" + (tFXSparksSiteZValue as string) + \
				", end_frame=" + (tFXSparksEndFrameValue as string) + \
				", fps=" + (tFXSparksFPSValue as string) + ")"
			)
		default: return undefined
		)

	local crashDist = if effect == #debris then tFXDebrisDistanceValue else tFXSparksDistanceValue

	local tempPy = outDir + "\\sb_tyfx_run.py"
	local f = openFile tempPy mode:"w"
	if f == undefined then
		(
		MessageBox ("Could not write temp file:\n" + tempPy) title:"tyflowFXLauncher"
		return undefined
		)
	format "import sys\n" to:f
	format "sys.path.insert(0, r'%')\n" libDir to:f
	format "from pymxs import runtime as rt\n" to:f
	format "import tyfx, raceanim\n" to:f
	format "spine = %\n" spine to:f
	format "spec = raceanim.CrashSpec(at_distance_m=%, spinner_slot=0)\n" (crashDist as string) to:f
	format "try:\n" to:f
	format "    res = %\n" call to:f
	format "    rt.tFXResultPath = str(res.get('path', ''))\n" to:f
	format "    rt.tFXResultSummary = str(res.get('summary', res.get('lines', '')))\n" to:f
	format "except Exception as e:\n" to:f
	format "    rt.tFXResultPath = ''\n" to:f
	format "    rt.tFXResultSummary = 'ERROR: ' + str(e)\n" to:f
	close f

	if tFXDryRunValue then
		(
		-- Dry Run: show what would be executed, generate nothing.
		format "\n[tyflowFXLauncher] DRY RUN - generated Python:\n"
		local rf = openFile tempPy
		while not (eof rf) do format "%\n" (readLine rf)
		close rf
		global tFXStatus = "Dry run - Python printed to Listener, nothing generated."
		MessageBox "Dry Run: the Python that would be executed has been printed to the MaxScript Listener.\n\nUncheck Dry Run to actually generate." title:"tyflowFXLauncher"
		return undefined
		)

	global tFXResultPath = ""
	global tFXResultSummary = ""
	try (python.ExecuteFile tempPy)
	catch
		(
		global tFXStatus = ("Python error: " + (getCurrentException() as string))
		MessageBox tFXStatus title:"tyflowFXLauncher"
		return undefined
		)

	if tFXResultPath == "" then
		(
		global tFXStatus = tFXResultSummary
		MessageBox ("Generation failed.\n\n" + tFXResultSummary) title:"tyflowFXLauncher"
		return undefined
		)

	global tFXStatus = ("Generated: " + tFXResultPath)
	return tFXResultPath
	)

fn tFXRunGenerated path =
	(
	-- Generated scripts build tyFlow objects, so wrap the whole thing in a
	-- single undo block - otherwise the artist cannot Ctrl-Z the FX setup.
	if path == undefined or not (doesFileExist path) then
		(
		MessageBox "Generate a script first." title:"tyflowFXLauncher"
		return false
		)
	if not (tFXCheckTyFlow()) then
		(
		MessageBox "tyFlow is not installed or not loaded.\n\nThe generated script will fail without it." title:"tyflowFXLauncher"
		return false
		)
	if not (queryBox ("REVIEW the generated script before running.\n\nHave you reviewed it?\n\nPath: " + path) title:"tyflowFXLauncher - Safety Check") then return false

	theHold.Begin()
	local ok = true
	try (fileIn path)
	catch
		(
		ok = false
		global tFXStatus = ("Run failed: " + (getCurrentException() as string))
		)
	if ok then
		(
		theHold.Accept "tyflowFXLauncher"
		global tFXStatus = "Ran generated script (undoable)."
		)
	else theHold.Cancel()
	return ok
	)

fn tFXHelp =
	(
	MessageBox "tyflowFXLauncher: Generate tyFlow FX MaxScript via tyfx.py.\n\n1. Pick the circuit SPLINE. tyfx.py builds its speed profile from the spline vertices, and every effect is gated on it. At least 3 knots.\n2. Enter emitter / wing / floor node names (comma-separated).\n3. Set parameters.\n4. Dry Run prints the Python to the Listener without generating.\n5. Generate writes a .ms file to disk.\n6. Open reviews it in the MaxScript editor.\n7. Run executes it inside an undo block - review it first.\n\nCrash Distance sets where along the circuit the crash occurs (metres).\n\nRequires the tyFlow plugin." title:"tyflowFXLauncher Help"
	)

fn tyflowFXLauncherDefaults = (tFXLoadDef())
fn tyflowFXLauncherUI = (tFXLoadDef(); tFXCloseOpenUI tFXPosValue)

fn tFXCloseOpenUI pos =
	(
	if tFXFloater != undefined then CloseRolloutFloater tFXFloater
	tFXDefineUI()
	tFXFloater = newRolloutFloater "tyflowFXLauncher v2.00" 380 470 pos.x pos.y
	addRollout tFXRollout tFXFloater
	)

fn tFXLoadDef =
	(
	presetDir = ((getdir #plugcfg) + "\\SoulburnScripts\\presets\\")
	f = presetDir + "tyflowFXLauncher.ini"
	if (sLibFileExist f == true) then
		(
		tFXSpineName = sLibGetINIString f "tyflowFX" "tFXSpineName" ""
		tFXDryRunValue = sLibGetINIBoolean f "tyflowFX" "tFXDryRunValue" false
		tFXSmokeEndFrameValue = sLibGetINIInteger f "tyflowFX" "tFXSmokeEndFrameValue" 100
		tFXSmokeWindBearingValue = sLibGetINIFloat f "tyflowFX" "tFXSmokeWindBearingValue" 270.0
		tFXSmokeWindSpeedValue = sLibGetINIFloat f "tyflowFX" "tFXSmokeWindSpeedValue" 5.0
		tFXSmokeSpeedThresholdValue = sLibGetINIFloat f "tyflowFX" "tFXSmokeSpeedThresholdValue" 30.0
		tFXSmokeSiteZValue = sLibGetINIFloat f "tyflowFX" "tFXSmokeSiteZValue" 0.0
		tFXSmokeEmitterNames = sLibGetINIString f "tyflowFX" "tFXSmokeEmitterNames" ""
		tFXDebrisEndFrameValue = sLibGetINIInteger f "tyflowFX" "tFXDebrisEndFrameValue" 100
		tFXDebrisSiteZValue = sLibGetINIFloat f "tyflowFX" "tFXDebrisSiteZValue" 0.0
		tFXDebrisFPSValue = sLibGetINIInteger f "tyflowFX" "tFXDebrisFPSValue" 24
		tFXDebrisWingNames = sLibGetINIString f "tyflowFX" "tFXDebrisWingNames" ""
		tFXDebrisDistanceValue = sLibGetINIFloat f "tyflowFX" "tFXDebrisDistanceValue" 3650.0
		tFXSparksEndFrameValue = sLibGetINIInteger f "tyflowFX" "tFXSparksEndFrameValue" 100
		tFXSparksSiteZValue = sLibGetINIFloat f "tyflowFX" "tFXSparksSiteZValue" 0.0
		tFXSparksFPSValue = sLibGetINIInteger f "tyflowFX" "tFXSparksFPSValue" 24
		tFXSparksFloorNames = sLibGetINIString f "tyflowFX" "tFXSparksFloorNames" ""
		tFXSparksDistanceValue = sLibGetINIFloat f "tyflowFX" "tFXSparksDistanceValue" 3650.0
		tFXPosValue = sLibGetINIPoint2 f "tyflowFX" "tFXPosValue" (sLibGetSafeUIPos 380 470)
		)
	)

fn tFXSaveDef =
	(
	presetDir = ((getdir #plugcfg) + "\\SoulburnScripts\\presets\\")
	if (getDirectories presetDir).count == 0 then makeDir presetDir
	f = presetDir + "tyflowFXLauncher.ini"
	if (sLibFileExist f == true) then deleteFile f
	setINISetting f "tyflowFX" "tFXSpineName" tFXSpineName
	setINISetting f "tyflowFX" "tFXDryRunValue" (tFXDryRunValue as string)
	setINISetting f "tyflowFX" "tFXSmokeEndFrameValue" (tFXSmokeEndFrameValue as string)
	setINISetting f "tyflowFX" "tFXSmokeWindBearingValue" (tFXSmokeWindBearingValue as string)
	setINISetting f "tyflowFX" "tFXSmokeWindSpeedValue" (tFXSmokeWindSpeedValue as string)
	setINISetting f "tyflowFX" "tFXSmokeSpeedThresholdValue" (tFXSmokeSpeedThresholdValue as string)
	setINISetting f "tyflowFX" "tFXSmokeSiteZValue" (tFXSmokeSiteZValue as string)
	setINISetting f "tyflowFX" "tFXSmokeEmitterNames" tFXSmokeEmitterNames
	setINISetting f "tyflowFX" "tFXDebrisEndFrameValue" (tFXDebrisEndFrameValue as string)
	setINISetting f "tyflowFX" "tFXDebrisSiteZValue" (tFXDebrisSiteZValue as string)
	setINISetting f "tyflowFX" "tFXDebrisFPSValue" (tFXDebrisFPSValue as string)
	setINISetting f "tyflowFX" "tFXDebrisWingNames" tFXDebrisWingNames
	setINISetting f "tyflowFX" "tFXDebrisDistanceValue" (tFXDebrisDistanceValue as string)
	setINISetting f "tyflowFX" "tFXSparksEndFrameValue" (tFXSparksEndFrameValue as string)
	setINISetting f "tyflowFX" "tFXSparksSiteZValue" (tFXSparksSiteZValue as string)
	setINISetting f "tyflowFX" "tFXSparksFPSValue" (tFXSparksFPSValue as string)
	setINISetting f "tyflowFX" "tFXSparksFloorNames" tFXSparksFloorNames
	setINISetting f "tyflowFX" "tFXSparksDistanceValue" (tFXSparksDistanceValue as string)
	setINISetting f "tyflowFX" "tFXPosValue" (tFXFloater.pos as string)
	)

-- UI

fn tFXDefineUI =
	(
	rollout tFXRollout "tyflowFXLauncher"
		(
		-- Label text cannot be an expression at definition time -- set in "on open"
		label tFXWarningLabel "tyFlow: checking..." align:#center

		pickbutton tFXSpinePick "Pick Circuit Spline..." width:230 align:#left across:2 \
			filter:(fn shapeOnly o = (superClassOf o == shape))
		checkbox tFXDryRunCheck "Dry Run" checked:false align:#right

		label tFXSpineLabel "Spline: <none>" align:#left

		tabs tFXTabs "FX Type" width:355 height:300
			(
			tab tFXSmokeTab "Tyre Smoke"
				(
				label tFXSmokeInfo "Emitter names (comma-sep):" align:#left
				edittext tFXSmokeEmittersEdit "" fieldWidth:300 align:#left
				spinner tFXSmokeWindBearingSpinner "Wind Bearing (deg): " range:[-360,360,270.0] fieldWidth:60 type:#float align:#right
				spinner tFXSmokeWindSpeedSpinner "Wind Speed (m/s): " range:[0,999,5.0] fieldWidth:60 type:#float align:#right
				spinner tFXSmokeSpeedThresholdSpinner "Speed Threshold (m/s): " range:[0,9999,30.0] fieldWidth:60 type:#float align:#right
				spinner tFXSmokeEndFrameSpinner "End Frame: " range:[1,99999,100] fieldWidth:60 type:#integer align:#right
				spinner tFXSmokeSiteZSpinner "Site Z: " range:[-99999,99999,0.0] fieldWidth:60 type:#float align:#right
				button tFXSmokeGenerateBtn "Generate .ms" width:100 align:#left across:3
				button tFXSmokeOpenBtn "Open in Editor" width:105 align:#center
				button tFXSmokeRunBtn "RUN (Review!)" width:105 align:#right

				on tFXSmokeEmittersEdit changed t do tFXSmokeEmitterNames = t
				on tFXSmokeWindBearingSpinner changed v do tFXSmokeWindBearingValue = v
				on tFXSmokeWindSpeedSpinner changed v do tFXSmokeWindSpeedValue = v
				on tFXSmokeSpeedThresholdSpinner changed v do tFXSmokeSpeedThresholdValue = v
				on tFXSmokeEndFrameSpinner changed v do tFXSmokeEndFrameValue = v
				on tFXSmokeSiteZSpinner changed v do tFXSmokeSiteZValue = v
				on tFXSmokeGenerateBtn pressed do
					(
					tFXSmokeGeneratedPath = tFXGenerate #smoke
					if tFXSmokeGeneratedPath != undefined then
						MessageBox ("Generated: " + tFXSmokeGeneratedPath + "\n\nReview before running.") title:"tyflowFXLauncher"
					)
				on tFXSmokeOpenBtn pressed do
					(
					if tFXSmokeGeneratedPath != undefined and (doesFileExist tFXSmokeGeneratedPath) then
						openMaxscriptEditorFile tFXSmokeGeneratedPath
					else MessageBox "Generate a script first." title:"tyflowFXLauncher"
					)
				on tFXSmokeRunBtn pressed do tFXRunGenerated tFXSmokeGeneratedPath
				)

			tab tFXDebrisTab "Crash Debris"
				(
				label tFXDebrisInfo "Wing names (comma-sep):" align:#left
				edittext tFXDebrisWingEdit "" fieldWidth:300 align:#left
				spinner tFXDebrisDistanceSpinner "Crash Distance (m): " range:[0,999999,3650.0] fieldWidth:60 type:#float align:#right
				spinner tFXDebrisEndFrameSpinner "End Frame: " range:[1,99999,100] fieldWidth:60 type:#integer align:#right
				spinner tFXDebrisSiteZSpinner "Site Z: " range:[-99999,99999,0.0] fieldWidth:60 type:#float align:#right
				spinner tFXDebrisFPSSpinner "FPS: " range:[1,999,24] fieldWidth:60 type:#integer align:#right
				button tFXDebrisGenBtn "Generate .ms" width:100 align:#left across:3
				button tFXDebrisOpenBtn "Open in Editor" width:105 align:#center
				button tFXDebrisRunBtn "RUN (Review!)" width:105 align:#right

				on tFXDebrisWingEdit changed t do tFXDebrisWingNames = t
				on tFXDebrisDistanceSpinner changed v do tFXDebrisDistanceValue = v
				on tFXDebrisEndFrameSpinner changed v do tFXDebrisEndFrameValue = v
				on tFXDebrisSiteZSpinner changed v do tFXDebrisSiteZValue = v
				on tFXDebrisFPSSpinner changed v do tFXDebrisFPSValue = v
				on tFXDebrisGenBtn pressed do
					(
					tFXDebrisGeneratedPath = tFXGenerate #debris
					if tFXDebrisGeneratedPath != undefined then
						MessageBox ("Generated: " + tFXDebrisGeneratedPath + "\n\nReview before running.") title:"tyflowFXLauncher"
					)
				on tFXDebrisOpenBtn pressed do
					(
					if tFXDebrisGeneratedPath != undefined and (doesFileExist tFXDebrisGeneratedPath) then
						openMaxscriptEditorFile tFXDebrisGeneratedPath
					else MessageBox "Generate a script first." title:"tyflowFXLauncher"
					)
				on tFXDebrisRunBtn pressed do tFXRunGenerated tFXDebrisGeneratedPath
				)

			tab tFXSparksTab "Crash Sparks"
				(
				label tFXSparksInfo "Floor names (comma-sep):" align:#left
				edittext tFXSparksFloorEdit "" fieldWidth:300 align:#left
				spinner tFXSparksDistanceSpinner "Crash Distance (m): " range:[0,999999,3650.0] fieldWidth:60 type:#float align:#right
				spinner tFXSparksEndFrameSpinner "End Frame: " range:[1,99999,100] fieldWidth:60 type:#integer align:#right
				spinner tFXSparksSiteZSpinner "Site Z: " range:[-99999,99999,0.0] fieldWidth:60 type:#float align:#right
				spinner tFXSparksFPSSpinner "FPS: " range:[1,999,24] fieldWidth:60 type:#integer align:#right
				button tFXSparksGenBtn "Generate .ms" width:100 align:#left across:3
				button tFXSparksOpenBtn "Open in Editor" width:105 align:#center
				button tFXSparksRunBtn "RUN (Review!)" width:105 align:#right

				on tFXSparksFloorEdit changed t do tFXSparksFloorNames = t
				on tFXSparksDistanceSpinner changed v do tFXSparksDistanceValue = v
				on tFXSparksEndFrameSpinner changed v do tFXSparksEndFrameValue = v
				on tFXSparksSiteZSpinner changed v do tFXSparksSiteZValue = v
				on tFXSparksFPSSpinner changed v do tFXSparksFPSValue = v
				on tFXSparksGenBtn pressed do
					(
					tFXSparksGeneratedPath = tFXGenerate #sparks
					if tFXSparksGeneratedPath != undefined then
						MessageBox ("Generated: " + tFXSparksGeneratedPath + "\n\nReview before running.") title:"tyflowFXLauncher"
					)
				on tFXSparksOpenBtn pressed do
					(
					if tFXSparksGeneratedPath != undefined and (doesFileExist tFXSparksGeneratedPath) then
						openMaxscriptEditorFile tFXSparksGeneratedPath
					else MessageBox "Generate a script first." title:"tyflowFXLauncher"
					)
				on tFXSparksRunBtn pressed do tFXRunGenerated tFXSparksGeneratedPath
				)
			)

		label tFXStatusLabel "Ready." align:#left

		button tFXHelpButton "Help" width:80 align:#left across:2
		button tFXSaveDefButton "SaveDef" width:80 align:#right

		on tFXSpinePick picked obj do
			(
			if obj != undefined then
				(
				tFXSpineName = obj.name
				tFXSpinePick.text = obj.name
				tFXSpineLabel.text = "Spline: " + obj.name
				)
			)
		on tFXDryRunCheck changed s do tFXDryRunValue = s
		on tFXHelpButton pressed do tFXHelp()
		on tFXSaveDefButton pressed do tFXSaveDef()

		on tFXRollout open do
			(
			if tFXCheckTyFlow() then
				tFXWarningLabel.text = "tyFlow: DETECTED [OK]"
			else
				tFXWarningLabel.text = "WARNING: tyFlow not installed"

			tFXDryRunCheck.checked = tFXDryRunValue
			if tFXSpineName.count > 0 then
				(
				tFXSpinePick.text = tFXSpineName
				tFXSpineLabel.text = "Spline: " + tFXSpineName
				)
			tFXSmokeEmittersEdit.text = tFXSmokeEmitterNames
			tFXSmokeWindBearingSpinner.value = tFXSmokeWindBearingValue
			tFXSmokeWindSpeedSpinner.value = tFXSmokeWindSpeedValue
			tFXSmokeSpeedThresholdSpinner.value = tFXSmokeSpeedThresholdValue
			tFXSmokeEndFrameSpinner.value = tFXSmokeEndFrameValue
			tFXSmokeSiteZSpinner.value = tFXSmokeSiteZValue
			tFXDebrisWingEdit.text = tFXDebrisWingNames
			tFXDebrisDistanceSpinner.value = tFXDebrisDistanceValue
			tFXDebrisEndFrameSpinner.value = tFXDebrisEndFrameValue
			tFXDebrisSiteZSpinner.value = tFXDebrisSiteZValue
			tFXDebrisFPSSpinner.value = tFXDebrisFPSValue
			tFXSparksFloorEdit.text = tFXSparksFloorNames
			tFXSparksDistanceSpinner.value = tFXSparksDistanceValue
			tFXSparksEndFrameSpinner.value = tFXSparksEndFrameValue
			tFXSparksSiteZSpinner.value = tFXSparksSiteZValue
			tFXSparksFPSSpinner.value = tFXSparksFPSValue
			tFXStatusLabel.text = tFXStatus
			)
		)
	)
)
-------------------------------------------------------------------------------
